# ========================================================
# TIMS - Client Environment Configuration
# Firebase Web App Credentials
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ========================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Cloud Console OAuth 2.0 Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# Backend API URL (Optional: Leave blank for local development proxy / auto-detection)
VITE_API_URL=
