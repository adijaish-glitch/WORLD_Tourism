{
  "name": "tims",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "cd client && npm install && cd ../server && npm install",
    "db:migrate": "cd server && npm run migrate",
    "db:seed": "cd server && npm run seed",
    "db:setup": "cd server && npm run migrate && npm run seed",
    "build": "npm run render:build",
    "render:build": "cd server && npm install --legacy-peer-deps",
    "build:client": "cd client && npm run build",
    "start": "node server/src/app.js"
  },
  "dependencies": {
    "concurrently": "^9.0.1",
    "pptxgenjs": "^4.0.1"
  }
}
