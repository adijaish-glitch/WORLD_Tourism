# ========================================================
# TIMS - Tourism Information Management System
# Server Environment Configuration
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT & Session Security
JWT_SECRET=replace_with_a_strong_random_secret
SESSION_EXPIRES_IN=7d

# MongoDB Configuration (Used for user profiles & authentication details)
MONGODB_URI=mongodb://localhost:27017/tims_tourism
# For MongoDB Atlas (Cloud), use:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tims_tourism?retryWrites=true&w=majority

# SMS Gateway (Twilio for Phone OTP verification)
# Leave blank to use dev mode (OTP will be displayed in server logs & test response)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google OAuth (Google Identity Services)
# Configure from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In
# Configure from Apple Developer Portal -> Certificates, Identifiers & Prof11`iles
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email Delivery (SMTP / Nodemailer for verification & password reset)
# Leave blank to use dev mode (reset/verify links will be printed in server logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TIMS Support" <support@tims-tourism.com>

# Firebase Admin SDK (Used for server-side token verification)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ========================================================
# Travel Provider Integrations & Partner APIs (Phase 3 & 4)
# ========================================================
# Amadeus Travel API (Flights & Hotels)
# Register at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test # or production

# MakeMyTrip Partner & Affiliate Program
# Register at https://mypartner.makemytrip.com/
MAKEMYTRIP_PARTNER_ID=
MAKEMYTRIP_AFFILIATE_KEY=

# Railway & IRCTC Ticketing Agency Configuration
# Register via authorized IRCTC Principal Service Provider or Web Services Agreement
IRCTC_PARTNER_CODE=
IRCTC_AGENCY_CREDENTIAL=

# Bus Operator Aggregator (e.g. RedBus / AbhiBus B2B Partner API)
REDBUS_API_KEY=
REDBUS_CLIENT_SECRET=


